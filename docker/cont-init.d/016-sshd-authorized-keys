#!/command/with-contenv sh
# shellcheck shell=sh
# Enable the optional SSH service only when an operator supplies an authorized
# key file on the durable Hermes volume. The image itself never contains keys.

set -eu

HERMES_HOME="${HERMES_HOME:-/opt/data}"
source_keys="$HERMES_HOME/.ssh/authorized_keys"
disabled_marker=/run/hermes-sshd-disabled

if [ ! -f "$source_keys" ] || [ -L "$source_keys" ]; then
    : > "$disabled_marker"
    echo "[sshd] no regular authorized_keys file; SSH service disabled"
    exit 0
fi

mkdir -p /root/.ssh /run/sshd
chmod 0700 /root/.ssh
install -m 0600 "$source_keys" /root/.ssh/authorized_keys
ssh-keygen -A >/dev/null 2>&1
/usr/sbin/sshd -t
rm -f "$disabled_marker"
echo "[sshd] key-only SSH service enabled"
